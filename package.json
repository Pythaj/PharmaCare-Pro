{
  "name": "nextjs_tailwind_shadcn_ts",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 8000",
    "build": "node scripts/vercel-build.mjs",
    "build:netlify": "prisma generate --schema prisma/schema.postgres.prisma && next build --webpack && node scripts/fix-turbopack-junctions.mjs",
    "start": "next start",
    "lint": "eslint .",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts",
    "db:import-drugs": "node scripts/import-drugs.cjs",
    "db:setup": "prisma migrate dev --name init && ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts",
    "db:push:pg": "prisma db push --schema prisma/schema.postgres.prisma",
    "db:generate:pg": "prisma generate --schema prisma/schema.postgres.prisma",
    "data:to-pg": "node scripts/sqlite-to-postgres.mjs",
    "desktop:build": "set NEXT_DESKTOP_BUILD=1&& prisma generate && next build && node scripts/desktop-build.mjs",
    "desktop:assemble": "node scripts/desktop-build.mjs"
  },
  "prisma": {
    "seed": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts"
  },
