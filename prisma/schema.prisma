generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A physical pharmacy location.
///
/// The governing rule of multi-branch: the CATALOGUE is shared, the STOCK and
/// MONEY are not. Product, Category, Supplier and Customer stay global (one
/// price list, one supplier list, one customer book). `branchId` therefore
/// appears only on the tables that represent physical stock or financial
/// events — Batch, Sale, Purchase, DailySalesRecord — and never on the
/// catalogue. Putting it on Product would fork the catalogue per branch and
/// make "does this drug exist anywhere?" unanswerable.
model Branch {
  id        String   @id @default(cuid())
  name      String
  /// Short unique code (e.g. "MAIN", "ACCRA") used to build invoice numbers
  /// that stay unique per branch, not just per day.
  code      String   @unique
  address   String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  batches      Batch[]
  sales        Sale[]
  purchases    Purchase[]
  dailyRecords DailySalesRecord[]
  auditLogs    AuditLog[]
  transfersOut StockTransfer[] @relation("TransferOut")
  transfersIn  StockTransfer[] @relation("TransferIn")
  productSettings BranchProductSetting[]

  @@map("branches")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("sales") // "admin" or "sales"
  phone     String?
  /// Home branch. NULL means "every branch" and is reserved for admins/owners:
  /// it is what lets the owner see the whole business while a salesperson is
  /// pinned to the counter they actually work at.
  branchId  String?
  active    Boolean  @default(true)
  mustChangePassword Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch     Branch?   @relation(fields: [branchId], references: [id])
  sales     Sale[]
  purchases Purchase[]
  returns   Return[]
  auditLogs AuditLog[]
    openedDailyRecords  DailySalesRecord[] @relation("DailyRecordOpener")
    closedDailyRecords  DailySalesRecord[] @relation("DailyRecordCloser")
    transfersCreated    StockTransfer[]   @relation("TransferCreatedBy")
    transfersApproved   StockTransfer[]   @relation("TransferApprovedBy")

  @@index([branchId])
  @@map("users")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]

  @@map("categories")
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  contact   String?
  email     String?
  phone     String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]

  @@map("suppliers")
}

model Product {
  id          String     @id @default(cuid())
  name        String
  genericName String?
  categoryId  String?
  description String?
  unit                String     @default("units") // "tablets", "capsules", "bottles", "sachets", "ml", "units"
  reorderLevel        Int       @default(10)
  defaultCostPrice    Decimal     @default(0)
  defaultSellingPrice Float     @default(0)
  active              Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  category    Category?  @relation(fields: [categoryId], references: [id])
    batches     Batch[]
    saleItems   SaleItem[]
    transferLines StockTransferLine[]
    branchSettings BranchProductSetting[]

  @@index([active])
  @@index([categoryId])
  @@map("products")
}

/// Per-branch overrides for the catalogue fields that legitimately differ
/// between branches.
///
/// The catalogue itself stays shared — Panadol is Panadol in every branch, and
/// duplicating the product per shop would create exactly the drift this is
/// meant to prevent. But two things on a product are *not* the same in every
/// shop:
///
///  1. `Product.reorderLevel`. A flagship branch ordering 200 units of a
///     product and a village branch ordering 20 cannot both be served by one
///     number. Because the threshold was global while the stock it was compared
///     against is branch-scoped, setting it at Branch A silently moved Branch B's
///     "low stock" line and reorder shortfall with it. That is a genuine
///     cross-branch leak, not a display detail.
///
///  2. The default price for NEW batches. `Batch.sellingPrice` is already
///     per-branch and is what the till actually charges, so this column does
///     NOT reprice stock already on a shelf — it only supplies the starting
///     value when a batch is received without an explicit price, so a branch
///     that prices a product differently does not have to remember to retype
///     it on every delivery.
///
/// Every column is nullable and NULL means "inherit the chain-wide Product
/// value", so a row is only created when an admin deliberately overrides
/// something. A branch with no row behaves exactly as it did before.
model BranchProductSetting {
  id        String   @id @default(cuid())
  productId String
  branchId  String
  /// NULL = inherit `Product.reorderLevel`. 0 is meaningful and distinct from
  /// NULL: 0 means "never flag as low stock at this branch", NULL means "use
  /// whatever the chain-wide setting says".
  reorderLevel Int?
  /// NULL = inherit `Product.defaultSellingPrice` when receiving a new batch.
  sellingPrice Float?
  /// NULL = inherit `Product.defaultCostPrice` when receiving a new batch.
  costPrice    Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  /// One override row per (product, branch). Without this, two concurrent
  /// saves could write competing thresholds for the same branch and the winner
  /// would be arbitrary.
  @@unique([productId, branchId])
  @@index([branchId])
  @@map("branch_product_settings")
}

model Batch {
  id            String   @id @default(cuid())
  productId     String
  /// Stock is owned by exactly one branch: this is the field that stops Branch A
  /// selling units that are physically sitting on Branch B's shelf.
  ///
  /// NOT NULL is load-bearing, not stylistic. It participates in the compound
  /// unique below, and in both SQLite and PostgreSQL NULLs are DISTINCT inside a
  /// unique index — so a nullable branchId would let two rows share the same
  /// product + batchNumber and quietly defeat the constraint that stops a
  /// duplicate batch being created.
  branchId      String
  batchNumber   String
  quantity      Int      @default(0)
  costPrice     Decimal    @default(0)
  sellingPrice  Decimal    @default(0)
  expiryDate    DateTime
  purchaseId    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch        Branch   @relation(fields: [branchId], references: [id])
  purchase      Purchase? @relation(fields: [purchaseId], references: [id])
  saleItems     SaleItem[]
  transferLinesOut StockTransferLine[] @relation("TransferSource")
  transferLinesIn  StockTransferLine[] @relation("TransferDest")

  // Was [productId, batchNumber]. The same supplier delivery legitimately exists
  // in two branches, so the branch is now part of the batch's identity.
  @@unique([productId, batchNumber, branchId])
  @@index([branchId])
  @@map("batches")
}

model Purchase {
  id          String   @id @default(cuid())
  invoiceNo   String
  supplierId  String?
  userId      String?
  /// Which branch physically received this delivery.
  branchId    String
  totalAmount Float    @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  user        User?      @relation(fields: [userId], references: [id])
  branch      Branch     @relation(fields: [branchId], references: [id])
  batches     Batch[]

  @@index([branchId])
  @@map("purchases")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales     Sale[]

  @@map("customers")
}

model Sale {
  id            String   @id @default(cuid())
  invoiceNo     String   @unique
  customerId    String?
  userId        String?
  /// What the goods came to before payment. With no discount and no tax
  /// anywhere in this app, this IS the amount charged — `totalAmount` is kept
  /// as its own column so a sale's charged value is recorded once, at the
  /// moment of the transaction, and never has to be re-derived from the lines.
  subtotal      Decimal    @default(0)
  totalAmount   Decimal    @default(0)
  profit        Decimal    @default(0)
  /// The shop this sale physically happened at. Every branch figure in the
  /// owner dashboard and every report groups by this, and it is what stops a
  /// cashier at one branch seeing another's takings. NOT NULL because a sale
  /// that belongs to no branch cannot be reported on or reconciled.
  branchId      String
  paymentMethod String   @default("cash") // "cash", "card", "mobile_money"
  status        String   @default("completed") // "completed", "returned", "partial_return"
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer      Customer? @relation(fields: [customerId], references: [id])
  user          User?      @relation(fields: [userId], references: [id])
  branch        Branch     @relation(fields: [branchId], references: [id])
  items         SaleItem[]
  returns       Return[]

  @@index([createdAt])
  @@index([customerId])
  @@index([userId])
  @@index([branchId, createdAt])
  @@map("sales")
}

model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  productId String
  batchId   String?
  quantity  Int
  unitPrice Float
  costPrice Float
  total     Float
  expiryDate DateTime?
  createdAt DateTime @default(now())

  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
  batch     Batch?  @relation(fields: [batchId], references: [id])
  returnItems ReturnItem[]

  @@index([saleId])
  @@index([productId])
  @@index([batchId])
  @@map("sale_items")
}

model Return {
  id            String   @id @default(cuid())
  saleId        String
  // Optional so a deleted cashier account leaves the refund record intact
  // (mirrors Sale.userId / Purchase.userId). Kept as a real relation so the
  // operator who processed the refund can always be resolved.
  userId        String?
  reason        String
  totalRefund   Float
  status        String   @default("approved") // "pending", "approved", "rejected"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sale      Sale         @relation(fields: [saleId], references: [id])
  user      User?        @relation(fields: [userId], references: [id])
  items     ReturnItem[]

  @@index([userId])
  @@map("returns")
}

// Per-line return tracking: makes cumulative over-return validation possible
// (a SaleItem can never have more returned quantity than was purchased).
// refundAmount is the customer's actual money back for this line — the line's
// share of the sale's charged total — so the parts always add up to
// Return.totalRefund and to what was actually collected.
model ReturnItem {
  id            String @id @default(cuid())
  returnId      String
  saleItemId    String
  quantity      Int
  refundAmount  Float  @default(0)

  return   Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem SaleItem @relation(fields: [saleItemId], references: [id])

  @@map("return_items")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  /// Where the action happened. Recorded so a dispute ("who discounted that at
  /// the new branch?") can be settled from the log alone.
  branchId  String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])
  branch    Branch?  @relation(fields: [branchId], references: [id])

  @@index([createdAt])
  @@index([userId])
  @@index([branchId])
  @@map("audit_logs")
}

model DailySalesRecord {
  id                String    @id @default(cuid())
  /// Was `@unique` on its own, which allowed exactly ONE till record per day for
  /// the entire business — Branch B could not open its till on a day Branch A
  /// had already opened. The uniqueness is now per branch per day.
  date              String    // YYYY-MM-DD format
  /// NOT NULL: this field is half of the (date, branchId) unique key, and NULLs
  /// are distinct inside a unique index in both SQLite and PostgreSQL — a
  /// nullable branch would let two registers exist for the same day.
  branchId          String
  status            String    @default("open") // "open" | "closed"
  openedBy          String?
  closedBy          String?
  openedAt          DateTime  @default(now())
  closedAt          DateTime?
  totalRevenue      Decimal     @default(0)
  totalProfit       Decimal     @default(0)
  totalTransactions Int      @default(0)
  totalItemsSold    Int       @default(0)
  cashTotal         Decimal     @default(0)
  cardTotal         Decimal     @default(0)
  mobileMoneyTotal  Decimal     @default(0)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  opener            User?     @relation("DailyRecordOpener", fields: [openedBy], references: [id])
  closer            User?     @relation("DailyRecordCloser", fields: [closedBy], references: [id])
  branch            Branch    @relation(fields: [branchId], references: [id])

  @@unique([date, branchId])
  @@index([branchId])
  @@map("daily_sales_records")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

/// A movement of stock between two branches.
///
/// This model exists because the governing rule of multi-branch is that a Batch
/// belongs to exactly ONE branch. When units physically move from Branch A to
/// Branch B there is no honest way to represent that by editing `Batch.branchId`:
/// it would retro-actively re-attribute every sale that already referenced the
/// batch, and it cannot express a PARTIAL movement at all. So a transfer debits
/// the source batch and credits a destination batch, and this row is the
/// document that ties the two sides together.
///
/// Stock moves ONLY on `completed`. `pending` and `approved` are paperwork, and
/// a transfer that was never completed must leave both shelves exactly as it
/// found them.
model StockTransfer {
  id           String   @id @default(cuid())
  /// Human reference, e.g. "TRF-MAIN-0007". Unique like invoiceNo so a transfer
  /// can be quoted on a paper docket and found again unambiguously.
  reference    String   @unique
  fromBranchId String
  toBranchId   String
  status       String   @default("pending") // "pending", "approved", "completed", "rejected", "cancelled"
  notes        String?
  createdById  String?
  approvedById String?
  approvedAt   DateTime?
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  fromBranch Branch  @relation("TransferOut", fields: [fromBranchId], references: [id])
  toBranch   Branch  @relation("TransferIn", fields: [toBranchId], references: [id])
  createdBy  User?   @relation("TransferCreatedBy", fields: [createdById], references: [id])
  approvedBy User?   @relation("TransferApprovedBy", fields: [approvedById], references: [id])
  lines      StockTransferLine[]

  @@index([fromBranchId, createdAt])
  @@index([toBranchId, createdAt])
  @@index([status])
  @@map("stock_transfers")
}

/// One product's worth of movement within a transfer.
///
/// A line points at the batch it left AND (once completed) the batch it landed
/// in, so the movement stays traceable in both directions. The destination batch
/// is created on completion rather than at request time, because until the goods
/// physically arrive the receiving shelf must not appear to hold them.
model StockTransferLine {
  id            String  @id @default(cuid())
  transferId    String
  productId     String
  /// The batch the units were debited from. Kept after completion so the
  /// movement can always be traced back to the delivery it came from.
  sourceBatchId String
  /// The batch the units were credited into. NULL until the transfer completes.
  destBatchId   String?
  quantity      Int
  /// Cost per unit snapshotted when the transfer was raised, so a later price
  /// edit at the source branch cannot rewrite what this movement was worth.
  unitCost      Float   @default(0)

  transfer    StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product     Product       @relation(fields: [productId], references: [id])
  sourceBatch Batch         @relation("TransferSource", fields: [sourceBatchId], references: [id])
  destBatch   Batch?        @relation("TransferDest", fields: [destBatchId], references: [id])

  @@index([transferId])
  @@index([sourceBatchId])
  @@map("stock_transfer_lines")
}
