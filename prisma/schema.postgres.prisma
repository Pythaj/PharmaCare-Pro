// PostgreSQL schema for cloud deployments (Vercel / Netlify).
// Mirrors prisma/schema.prisma (SQLite) exactly — same models, same @@map names.
// Generate the client with:  prisma generate --schema prisma/schema.postgres.prisma
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A physical pharmacy location. The catalogue is shared; only stock and money
/// are branch-owned. See the identical comment block in prisma/schema.prisma.
model Branch {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  batches      Batch[]
  sales        Sale[]
  purchases    Purchase[]
  dailyRecords DailySalesRecord[]
  auditLogs    AuditLog[]
  transfersOut StockTransfer[] @relation("TransferOut")
  transfersIn  StockTransfer[] @relation("TransferIn")
  productSettings BranchProductSetting[]

  @@map("branches")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("sales") // "admin" or "sales"
  phone     String?
  /// Home branch. NULL = "every branch", reserved for admins/owners.
  branchId  String?
  active    Boolean  @default(true)
  mustChangePassword Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch     Branch?   @relation(fields: [branchId], references: [id])
  sales     Sale[]
  purchases Purchase[]
  returns   Return[]
  auditLogs AuditLog[]
    openedDailyRecords  DailySalesRecord[] @relation("DailyRecordOpener")
    closedDailyRecords  DailySalesRecord[] @relation("DailyRecordCloser")
    transfersCreated    StockTransfer[]   @relation("TransferCreatedBy")
    transfersApproved   StockTransfer[]   @relation("TransferApprovedBy")

  @@index([branchId])
  @@map("users")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products  Product[]

  @@map("categories")
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  contact   String?
  email     String?
  phone     String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]

  @@map("suppliers")
}

model Product {
  id          String     @id @default(cuid())
  name        String
  genericName String?
  categoryId  String?
  description String?
  unit                String     @default("units") // "tablets", "capsules", "bottles", "sachets", "ml", "units"
  reorderLevel        Int       @default(10)
  defaultCostPrice    Decimal     @default(0)
  defaultSellingPrice Float     @default(0)
  active              Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  category    Category?  @relation(fields: [categoryId], references: [id])
    batches     Batch[]
    saleItems   SaleItem[]
    transferLines StockTransferLine[]
    branchSettings BranchProductSetting[]

  @@index([active])
  @@index([categoryId])
  @@map("products")
}

/// Per-branch overrides for the catalogue fields that legitimately differ
/// between branches. The catalogue itself stays shared; only the reorder
/// threshold and the default price for NEW batches are branch-specific. Every
/// column is nullable and NULL means "inherit the chain-wide Product value", so
/// a branch with no row behaves exactly as it did before.
/// See the identical comment block in prisma/schema.prisma.
model BranchProductSetting {
  id        String   @id @default(cuid())
  productId String
  branchId  String
  /// NULL = inherit `Product.reorderLevel`. 0 is meaningful and distinct from
  /// NULL: 0 means "never flag as low stock at this branch".
  reorderLevel Int?
  /// NULL = inherit `Product.defaultSellingPrice` for newly received batches.
  /// This does NOT reprice stock already on a shelf — `Batch.sellingPrice` is
  /// what the till charges and it is already per branch.
  sellingPrice Float?
  /// NULL = inherit `Product.defaultCostPrice` for newly received batches.
  costPrice    Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([productId, branchId])
  @@index([branchId])
  @@map("branch_product_settings")
}

model Batch {
  id            String   @id @default(cuid())
  productId     String
  /// Stock is owned by exactly one branch. NOT NULL: it is half of a compound
  /// unique, and NULLs are distinct inside a unique index in PostgreSQL too.
  branchId      String
  batchNumber   String
  quantity      Int      @default(0)
  costPrice     Decimal    @default(0)
  sellingPrice  Decimal    @default(0)
  expiryDate    DateTime
  purchaseId    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch        Branch   @relation(fields: [branchId], references: [id])
  purchase      Purchase? @relation(fields: [purchaseId], references: [id])
  saleItems     SaleItem[]
  transferLinesOut StockTransferLine[] @relation("TransferSource")
  transferLinesIn  StockTransferLine[] @relation("TransferDest")

  // Was [productId, batchNumber] — the same delivery can exist in two branches.
  @@unique([productId, batchNumber, branchId])
  @@index([branchId])
  @@map("batches")
}

model Purchase {
  id          String   @id @default(cuid())
  invoiceNo   String
  supplierId  String?
  userId      String?
  /// Which branch physically received this delivery.
  branchId    String
  totalAmount Float    @default(0)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier    Supplier? @relation(fields: [supplierId], references: [id])
  user        User?      @relation(fields: [userId], references: [id])
  branch      Branch     @relation(fields: [branchId], references: [id])
  batches     Batch[]

  @@index([branchId])
  @@map("purchases")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales     Sale[]

  @@map("customers")
}

model Sale {
  id            String   @id @default(cuid())
  invoiceNo     String   @unique
  customerId    String?
  userId        String?
  /// What the goods came to before payment. With no discount and no tax
  /// anywhere in this app, this IS the amount charged — `totalAmount` is kept
  /// as its own column so a sale's charged value is recorded once, at the
  /// moment of the transaction, and never has to be re-derived from the lines.
  subtotal      Decimal    @default(0)
  totalAmount   Decimal    @default(0)
  profit        Decimal    @default(0)
  /// The shop this sale physically happened at. NOT NULL so every sale is reportable.
  branchId      String
  paymentMethod String   @default("cash") // "cash", "card", "mobile_money"
  status        String   @default("completed") // "completed", "returned", "partial_return"
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer      Customer? @relation(fields: [customerId], references: [id])
  user          User?      @relation(fields: [userId], references: [id])
  branch        Branch     @relation(fields: [branchId], references: [id])
  items         SaleItem[]
  returns       Return[]

  @@index([createdAt])
  @@index([customerId])
  @@index([userId])
  @@index([branchId, createdAt])
  @@map("sales")
}

model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  productId String
  batchId   String?
  quantity  Int
  unitPrice Float
  costPrice Float
  total     Float
  expiryDate DateTime?
  createdAt DateTime @default(now())

  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
  batch     Batch?  @relation(fields: [batchId], references: [id])
  returnItems ReturnItem[]

  @@index([saleId])
  @@index([productId])
  @@index([batchId])
  @@map("sale_items")
}

model Return {
  id            String   @id @default(cuid())
  saleId        String
  // Optional so a deleted cashier account leaves the refund record intact
  // (mirrors Sale.userId / Purchase.userId). Kept as a real relation so the
  // operator who processed the refund can always be resolved.
  userId        String?
  reason        String
  totalRefund   Float
  status        String   @default("approved") // "pending", "approved", "rejected"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sale      Sale         @relation(fields: [saleId], references: [id])
  user      User?        @relation(fields: [userId], references: [id])
  items     ReturnItem[]

  @@index([userId])
  @@map("returns")
}

// Per-line return tracking: makes cumulative over-return validation possible
// (a SaleItem can never have more returned quantity than was purchased).
// refundAmount is the customer's actual money back for this line — the line's
// share of the sale's charged total — so the parts always add up to
// Return.totalRefund and to what was actually collected.
model ReturnItem {
  id            String @id @default(cuid())
  returnId      String
  saleItemId    String
  quantity      Int
  refundAmount  Float  @default(0)

  return   Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  saleItem SaleItem @relation(fields: [saleItemId], references: [id])

  @@map("return_items")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  /// Where the action happened, for settling disputes from the log alone.
  branchId  String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])
  branch    Branch?  @relation(fields: [branchId], references: [id])

  @@index([createdAt])
  @@index([userId])
  @@index([branchId])
  @@map("audit_logs")
}

model DailySalesRecord {
  id                String    @id @default(cuid())
  /// Was @unique alone, allowing only ONE till record per day for the whole
  /// business. Uniqueness is now per branch per day.
  date              String    // YYYY-MM-DD format
  /// NOT NULL: half of the (date, branchId) unique key.
  branchId          String
  status            String    @default("open") // "open" | "closed"
  openedBy          String?
  closedBy          String?
  openedAt          DateTime  @default(now())
  closedAt          DateTime?
  totalRevenue      Decimal     @default(0)
  totalProfit       Decimal     @default(0)
  totalTransactions Int      @default(0)
  totalItemsSold    Int       @default(0)
  cashTotal         Decimal     @default(0)
  cardTotal         Decimal     @default(0)
  mobileMoneyTotal  Decimal     @default(0)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  opener            User?     @relation("DailyRecordOpener", fields: [openedBy], references: [id])
  closer            User?     @relation("DailyRecordCloser", fields: [closedBy], references: [id])
  branch            Branch    @relation(fields: [branchId], references: [id])

  @@unique([date, branchId])
  @@index([branchId])
  @@map("daily_sales_records")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
/// A movement of stock between two branches.
///
/// This model exists because the governing rule of multi-branch is that a Batch
/// belongs to exactly ONE branch. When units physically move from Branch A to
/// Branch B there is no honest way to represent that by editing `Batch.branchId`:
/// it would retro-actively re-attribute every sale that already referenced the
/// batch, and it cannot express a PARTIAL movement at all. So a transfer debits
/// the source batch and credits a destination batch, and this row is the
/// document that ties the two sides together.
///
/// Stock moves ONLY on `completed`. `pending` and `approved` are paperwork, and
/// a transfer that was never completed must leave both shelves exactly as it
/// found them.
model StockTransfer {
  id           String   @id @default(cuid())
  /// Human reference, e.g. "TRF-MAIN-0007". Unique like invoiceNo so a transfer
  /// can be quoted on a paper docket and found again unambiguously.
  reference    String   @unique
  fromBranchId String
  toBranchId   String
  status       String   @default("pending") // "pending", "approved", "completed", "rejected", "cancelled"
  notes        String?
  createdById  String?
  approvedById String?
  approvedAt   DateTime?
  completedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  fromBranch Branch  @relation("TransferOut", fields: [fromBranchId], references: [id])
  toBranch   Branch  @relation("TransferIn", fields: [toBranchId], references: [id])
  createdBy  User?   @relation("TransferCreatedBy", fields: [createdById], references: [id])
  approvedBy User?   @relation("TransferApprovedBy", fields: [approvedById], references: [id])
  lines      StockTransferLine[]

  @@index([fromBranchId, createdAt])
  @@index([toBranchId, createdAt])
  @@index([status])
  @@map("stock_transfers")
}

/// One product's worth of movement within a transfer.
///
/// A line points at the batch it left AND (once completed) the batch it landed
/// in, so the movement stays traceable in both directions. The destination batch
/// is created on completion rather than at request time, because until the goods
/// physically arrive the receiving shelf must not appear to hold them.
model StockTransferLine {
  id            String  @id @default(cuid())
  transferId    String
  productId     String
  /// The batch the units were debited from. Kept after completion so the
  /// movement can always be traced back to the delivery it came from.
  sourceBatchId String
  /// The batch the units were credited into. NULL until the transfer completes.
  destBatchId   String?
  quantity      Int
  /// Cost per unit snapshotted when the transfer was raised, so a later price
  /// edit at the source branch cannot rewrite what this movement was worth.
  unitCost      Float   @default(0)

  transfer    StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product     Product       @relation(fields: [productId], references: [id])
  sourceBatch Batch         @relation("TransferSource", fields: [sourceBatchId], references: [id])
  destBatch   Batch?        @relation("TransferDest", fields: [destBatchId], references: [id])

  @@index([transferId])
  @@index([sourceBatchId])
  @@map("stock_transfer_lines")
}

/// Historic VAT charged per sale, preserved from the retired tax/discount feature.
///
/// `sales.tax` and `sales.discount` were dropped from the schema when that
/// feature was removed, but the figures on past sales are the shop's tax history
/// and cannot be thrown away. `scripts/archive-legacy-money.sql` copies every
/// non-zero value here on the deploy that drops the columns, so the money stays
/// in the pharmacy's own database, keyed to the invoice it belongs to.
///
/// `@@ignore()` is the load-bearing part: Prisma will neither create, alter nor
/// drop this table, so no future schema push can destroy it.
model LegacySaleMoney {
  /// `Sale.id` of the row the figures came from.
  saleId    String
  /// The invoice number as printed on the receipt, so the row can be matched to
  /// paper without needing the sales table at all.
  invoiceNo String
  soldAt    DateTime
  tax       Decimal
  discount  Decimal
  archivedAt DateTime @default(now())

  @@ignore()
  @@map("legacy_sale_money")
}

/// Historic discount per trading day, preserved from the same retired feature.
///
/// The register's own `daily_sales_records.totalDiscount` was dropped with it;
/// this is where that figure lives now. `@@ignore()` for the same reason as
/// `LegacySaleMoney`.
model LegacyDailyDiscount {
  /// `DailySalesRecord.id` the figure came from.
  recordId      String
  /// `DailySalesRecord.date` (YYYY-MM-DD) as the register keyed it.
  businessDate  String
  totalDiscount Decimal
  archivedAt    DateTime @default(now())

  @@ignore()
  @@map("legacy_daily_discount")
}
